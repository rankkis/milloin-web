{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "angular",
  "buildCommand": "npm run build",
  "outputDirectory": "dist/milloin-web-app/browser",
  "redirects": [
    {
      "source": "/:path(.*)",
      "has": [{ "type": "host", "value": "www.milloin.xyz" }],
      "destination": "https://milloin.xyz/:path",
      "permanent": true
    }
  ],
  "rewrites": [
    { "source": "/api", "destination": "https://milloin-server.vercel.app/api" },
    { "source": "/api/openapi.json", "destination": "https://milloin-server.vercel.app/api-json" },
    { "source": "/api/:asset(swagger-ui.*)", "destination": "https://milloin-server.vercel.app/api/:asset" },
    { "source": "/api/api/:asset(swagger-ui.*)", "destination": "https://milloin-server.vercel.app/api/api/:asset" },
    { "source": "/api/:path*", "destination": "https://milloin-server.vercel.app/:path*" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)\\.(js|css)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/media/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ]
}
